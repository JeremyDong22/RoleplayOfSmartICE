# PWA Cache Control Configuration
# Ensures service worker and HTML files are never cached
# While allowing longer caching for static assets

# Service Worker - No caching
<FilesMatch "sw\.js$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</FilesMatch>

# HTML files - No caching
<FilesMatch "\.(html)$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</FilesMatch>

# Manifest file - Short cache
<FilesMatch "manifest\.json$">
  Header set Cache-Control "max-age=3600"
</FilesMatch>

# JavaScript and CSS - 1 hour cache (for development, increase in production)
<FilesMatch "\.(js|css)$">
  Header set Cache-Control "max-age=3600, must-revalidate"
</FilesMatch>

# Images and fonts - 7 days cache
<FilesMatch "\.(jpg|jpeg|png|gif|svg|ico|woff|woff2|ttf|eot)$">
  Header set Cache-Control "max-age=604800, public"
</FilesMatch>

# Face recognition models - 30 days cache
<FilesMatch "\.(bin|json)$">
  Header set Cache-Control "max-age=2592000, public"
</FilesMatch>

# Enable gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>